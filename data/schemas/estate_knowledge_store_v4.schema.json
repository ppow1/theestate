{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate://schemas/estate_knowledge_store_v4",
  "title": "Estate rebuildable knowledge projection v4",
  "type": "object",
  "required": ["schema_version", "evidence_facts", "assertion_evidence"],
  "properties": {
    "schema_version": {"const": "estate.knowledge_store.v4"},
    "evidence_facts": {"type": "array"},
    "assertion_evidence": {"type": "array"},
    "candidate_assertions": {"type": "array"},
    "review_decisions": {"type": "array"},
    "applied_comprehension": {"type": "array"},
    "application_history": {"type": "array"},
    "revalidation_queue": {"type": "array"}
  },
  "additionalProperties": true
}
