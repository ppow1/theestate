{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.knowledge_store.v2",
  "title": "Estate Knowledge Store status and population contract",
  "type": "object",
  "required": ["schema_version", "database", "migration_version"],
  "properties": {
    "schema_version": {"const": "estate.knowledge_store.v2"},
    "database": {"type": "string", "minLength": 1},
    "migration_version": {"const": 2},
    "assets_total": {"type": "integer", "minimum": 0},
    "metadata_only": {"type": "integer", "minimum": 0},
    "no_content": {"type": "integer", "minimum": 0},
    "structural": {"type": "integer", "minimum": 0},
    "pending_work": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
