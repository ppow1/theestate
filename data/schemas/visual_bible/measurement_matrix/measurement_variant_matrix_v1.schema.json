{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.measurement_variant_matrix.v1",
  "title": "WP-4130 governed resident measurement variant matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "resident_id", "authority", "provenance", "intended_variable", "fixed_variables", "resident_constraints", "variants", "capture_relationship", "steward_review", "revision", "integrity"],
  "properties": {
    "schema_version": {"const": "measurement_variant_matrix_v1"},
    "matrix_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+_mvm_r[0-9]{3}$"},
    "resident_id": {"type": "string", "minLength": 1},
    "authority": {"type": "object", "required": ["resident_id", "authority_type"], "properties": {"resident_id": {"type": "string"}, "authority_type": {"const": "resident_visual_bible"}}},
    "provenance": {"type": "object"},
    "intended_variable": {"type": "object", "required": ["name", "category", "reason"], "properties": {"name": {"type": "string"}, "category": {"enum": ["top", "middle", "bottom"]}, "reason": {"type": "string", "minLength": 1}}},
    "fixed_variables": {"type": "object"},
    "resident_constraints": {"type": "object"},
    "variants": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/variant"}},
    "capture_relationship": {"type": "object"},
    "steward_review": {"type": "object"},
    "revision": {"type": "object"},
    "integrity": {"type": "object"}
  },
  "$defs": {
    "variant": {
      "type": "object", "required": ["variant_id", "role", "label", "state", "measurements", "fixed_fingerprint"],
      "properties": {
        "variant_id": {"type": "string", "pattern": "^[a-z0-9_-]+:(baseline|lower|target|higher):r[0-9]{3}$"},
        "role": {"enum": ["baseline", "lower", "target", "higher"]},
        "label": {"type": "string", "minLength": 1},
        "state": {"enum": ["candidate", "selected", "rejected", "superseded", "unresolved"]},
        "measurements": {"type": "object", "additionalProperties": {"type": "object", "required": ["value", "unit"], "properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["cm", "mm", "ratio"]}}}},
        "fixed_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
