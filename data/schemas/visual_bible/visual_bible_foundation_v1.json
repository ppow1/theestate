{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.visual_bible.foundation.v1",
  "title": "Estate Visual Bible Foundation v1",
  "type": "object",
  "required": ["schema_version", "resident", "visibility_layers", "physical_specification", "facial_geometry", "visual_fingerprint", "scale_reference", "wardrobe_library", "prompt_canon", "negative_prompt_canon", "review_workflow", "asset_library", "canonical_lock"],
  "properties": {
    "schema_version": {"const": "visual_bible_foundation_v1"},
    "resident": {"type": "object", "required": ["resident_id", "display_name", "adult_status", "identity_document_refs"], "properties": {"resident_id": {"type": "string"}, "display_name": {"type": "string"}, "adult_status": {"const": "adult"}, "identity_document_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "visibility_layers": {"type": "array", "items": {"enum": ["public", "internal", "restricted", "private"]}, "contains": {"const": "public"}},
    "physical_specification": {"$ref": "#/$defs/physical_specification"},
    "facial_geometry": {"$ref": "#/$defs/facial_geometry"},
    "visual_fingerprint": {"$ref": "#/$defs/visual_fingerprint"},
    "scale_reference": {"$ref": "#/$defs/scale_reference"},
    "wardrobe_library": {"$ref": "#/$defs/wardrobe_library"},
    "prompt_canon": {"$ref": "#/$defs/prompt_canon"},
    "negative_prompt_canon": {"$ref": "#/$defs/negative_prompt_canon"},
    "review_workflow": {"$ref": "#/$defs/review_workflow"},
    "asset_library": {"$ref": "#/$defs/asset_library"},
    "canonical_lock": {"$ref": "#/$defs/canonical_lock"}
  },
  "$defs": {
    "provenance": {"type": "object", "required": ["source", "created_at", "created_by", "hash"], "properties": {"source": {"type": "string"}, "created_at": {"type": "string"}, "created_by": {"type": "string"}, "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "lineage": {"type": "array", "items": {"type": "string"}}, "replacement_for": {"type": "string"}}},
    "review_state": {"enum": ["draft", "pending_steward_review", "revision_requested", "provisionally_approved", "canonical", "rejected", "superseded"]},
    "physical_specification": {"type": "object", "required": ["status", "steward_approval", "height", "measurements", "build_class", "silhouette", "posture", "provenance"], "properties": {"status": {"enum": ["provisional", "canonical", "superseded"]}, "steward_approval": {"type": "object", "required": ["approved", "notes"], "properties": {"approved": {"type": "boolean"}, "approval_date": {"type": "string"}, "notes": {"type": "string"}}}, "height": {"type": "object", "required": ["imperial", "centimeters"], "properties": {"imperial": {"type": "string"}, "centimeters": {"type": "number"}}}, "measurements": {"type": "object", "required": ["units", "values", "uncertainty"], "properties": {"units": {"enum": ["inches", "centimeters"]}, "values": {"type": "object"}, "uncertainty": {"type": "string"}}}, "build_class": {"type": "string"}, "silhouette": {"type": "string"}, "posture": {"type": "string"}, "footwear_adjusted_presentation": {"type": "array", "items": {"type": "object"}}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "facial_geometry": {"type": "object", "required": ["face_shape", "landmarks", "hair", "eyes", "artistic_ambiguity_note", "provenance"], "properties": {"face_shape": {"type": "string"}, "landmarks": {"type": "object"}, "hair": {"type": "object"}, "eyes": {"type": "object", "required": ["color", "shape"]}, "artistic_ambiguity_note": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "visual_fingerprint": {"type": "object", "required": ["primary_cues", "secondary_cues", "never_exaggerate", "icon_scale_cues", "group_differentiation_cues"], "properties": {"primary_cues": {"type": "array", "minItems": 3, "maxItems": 7, "items": {"type": "string"}}, "secondary_cues": {"type": "array", "items": {"type": "string"}}, "never_exaggerate": {"type": "array", "items": {"type": "string"}}, "icon_scale_cues": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "group_differentiation_cues": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "scale_reference": {"type": "object", "required": ["head_to_body_ratio", "camera_standard", "required_views", "heel_comparison_required", "group_scale_rules"], "properties": {"head_to_body_ratio": {"type": "string"}, "camera_standard": {"type": "object", "required": ["focal_length", "horizon", "distance", "framing"]}, "required_views": {"type": "array", "items": {"enum": ["front", "front_three_quarter", "side", "rear_three_quarter", "rear"]}}, "heel_comparison_required": {"type": "object", "required": ["applicable", "minimum_inches"]}, "group_scale_rules": {"type": "array", "items": {"type": "string"}}}},
    "wardrobe_library": {"type": "object", "required": ["signature_looks", "categories", "fit_guidance", "restricted_categories"], "properties": {"signature_looks": {"type": "array", "items": {"type": "object"}}, "categories": {"type": "array", "items": {"enum": ["office", "casual", "formal", "activity", "seasonal", "uniform", "restricted"]}}, "fit_guidance": {"type": "array", "items": {"type": "string"}}, "restricted_categories": {"type": "array", "items": {"type": "object"}}}},
    "prompt_canon": {"type": "object", "required": ["identity_fragments", "asset_type_templates", "reproducibility_receipt_fields", "audience_scope"], "properties": {"identity_fragments": {"type": "array", "minItems": 1}, "asset_type_templates": {"type": "array", "minItems": 1}, "reproducibility_receipt_fields": {"type": "array", "items": {"type": "string"}}, "audience_scope": {"enum": ["public", "internal", "restricted", "private"]}}},
    "negative_prompt_canon": {"type": "object", "required": ["global_rules", "resident_rules", "comparison_rules", "group_rules", "defect_taxonomy"], "properties": {"global_rules": {"type": "array", "minItems": 10}, "resident_rules": {"type": "array", "minItems": 1}, "comparison_rules": {"type": "array", "minItems": 1}, "group_rules": {"type": "array", "minItems": 1}, "defect_taxonomy": {"type": "array", "minItems": 1}}},
    "review_workflow": {"type": "object", "required": ["states", "steward_notes_ledger", "measurement_variant_comparisons", "revision_packets", "emotional_anchors"], "properties": {"states": {"type": "array", "items": {"$ref": "#/$defs/review_state"}}, "steward_notes_ledger": {"type": "array"}, "measurement_variant_comparisons": {"type": "array", "items": {"$ref": "#/$defs/measurement_variant_comparison"}}, "revision_packets": {"type": "array"}, "emotional_anchors": {"type": "array"}}},
    "measurement_variant_comparison": {"type": "object", "required": ["comparison_id", "resident_id", "facial_fingerprint_hash", "variants", "fixed_variables", "views", "vertical_alignment", "heel_set", "steward_selection_notes", "regenerate_if_not_distinguishable"], "properties": {"comparison_id": {"type": "string"}, "resident_id": {"type": "string"}, "facial_fingerprint_hash": {"type": "string"}, "variants": {"type": "array", "minItems": 3, "maxItems": 3}, "fixed_variables": {"type": "array"}, "views": {"type": "array"}, "vertical_alignment": {"const": true}, "heel_set": {"type": "object", "required": ["included", "heel_height_inches"]}, "steward_selection_notes": {"type": "string"}, "regenerate_if_not_distinguishable": {"const": true}}},
    "asset_library": {"type": "object", "required": ["canonical", "candidates", "rejected", "superseded", "comparisons", "thumbnails", "group_images"], "properties": {"canonical": {"type": "array"}, "candidates": {"type": "array"}, "rejected": {"type": "array"}, "superseded": {"type": "array"}, "comparisons": {"type": "array"}, "thumbnails": {"type": "array"}, "group_images": {"type": "array"}}},
    "canonical_lock": {"type": "object", "required": ["status", "explicit_steward_approval_required", "lock_record", "unlock_controls", "hidden_caption_test_plan", "group_compatibility_gate"], "properties": {"status": {"enum": ["exploratory_draft", "review_candidate", "preferred_candidate", "provisionally_accepted", "canonically_locked", "superseded", "rejected"]}, "explicit_steward_approval_required": {"const": true}, "lock_record": {"type": "object"}, "unlock_controls": {"type": "object"}, "hidden_caption_test_plan": {"type": "string"}, "group_compatibility_gate": {"type": "string"}}}
  }
}
