{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theestate.local/schemas/visual_bible/prompts/prompt_request_v1.schema.json",
  "title": "prompt_request_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "audience_scope",
    "purpose",
    "residents",
    "layers",
    "adapter"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "audience_scope": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "private"
      ]
    },
    "purpose": {
      "enum": [
        "portrait",
        "full_body",
        "turnaround",
        "measurement_comparison",
        "pair",
        "group",
        "emotional_anchor",
        "icon",
        "illustration"
      ]
    },
    "residents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "layers": {
      "type": "object",
      "required": [
        "identity",
        "presence",
        "wardrobe",
        "pose",
        "environment",
        "camera",
        "rendering",
        "exclusion"
      ],
      "properties": {
        "identity": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "presence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wardrobe": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pose": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "camera": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rendering": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusion": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "object"
    }
  }
}
