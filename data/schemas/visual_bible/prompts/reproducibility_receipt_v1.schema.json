{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theestate.local/schemas/visual_bible/prompts/reproducibility_receipt_v1.schema.json",
  "title": "reproducibility_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "request_id",
    "resident_ids",
    "audience_scope",
    "prompt_version",
    "positive_prompt",
    "negative_prompt",
    "fragment_digests",
    "model",
    "model_version",
    "workflow_version",
    "seed",
    "dimensions",
    "parameters",
    "reference_ids",
    "adapter_ids",
    "generated_at",
    "review_state",
    "asset_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "resident_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audience_scope": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "private"
      ]
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "positive_prompt": {
      "type": "string",
      "minLength": 1
    },
    "negative_prompt": {
      "type": "string"
    },
    "fragment_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "model_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "dimensions": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object"
    },
    "reference_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adapter_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "review_required",
        "approved",
        "rejected"
      ]
    },
    "asset_status": {
      "enum": [
        "provisional",
        "canonical",
        "rejected",
        "retired"
      ]
    }
  }
}
