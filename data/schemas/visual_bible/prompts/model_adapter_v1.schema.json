{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theestate.local/schemas/visual_bible/prompts/model_adapter_v1.schema.json",
  "title": "model_adapter_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "audience_scope",
    "model",
    "model_version",
    "parameters",
    "identity_overrides"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "audience_scope": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "private"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "syntax": {
      "type": "object"
    },
    "known_quirks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identity_overrides": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
