{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theestate.local/schemas/visual_bible/prompts/prompt_fragment_v1.schema.json",
  "title": "prompt_fragment_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fragment_id",
    "resident_id",
    "audience_scope",
    "layer",
    "version",
    "status",
    "text",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "fragment_id": {
      "type": "string",
      "minLength": 1
    },
    "resident_id": {
      "type": "string",
      "minLength": 1
    },
    "audience_scope": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "private"
      ]
    },
    "layer": {
      "enum": [
        "identity",
        "presence",
        "wardrobe",
        "pose",
        "environment",
        "camera",
        "rendering",
        "exclusion"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "review_required",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_ids",
        "created_at",
        "created_by"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
