{
  "$id": "https://theestate.local/schemas/workforce_development/workforce_request_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "examples": [
    {
      "classification": "Estate Internal",
      "constitutional_authority_granted": false,
      "created_at": "2026-07-10T00:00:00Z",
      "metadata": {},
      "operational_queue_control_performed": false,
      "provider_execution_performed": false,
      "request_id": "wfr-example",
      "request_type": "worker_health_review",
      "requested_outcome": "Assess worker and institutional causes.",
      "requesting_office": "Engineering",
      "requires_boundary_review": false,
      "requires_steward_attention": false,
      "schema_version": "workforce_request.v1",
      "source_artifacts": [],
      "status": "open",
      "subject_id": "worker-42",
      "subject_type": "worker",
      "summary": "Repeated mistakes and context strain require review."
    }
  ],
  "not": {
    "required": [
      "journal_body"
    ]
  },
  "properties": {
    "classification": {
      "enum": [
        "Public",
        "Estate Internal",
        "Restricted",
        "Steward Only",
        "Local Only",
        "Sensitive",
        "Private"
      ]
    },
    "constitutional_authority_granted": {
      "const": false
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "operational_queue_control_performed": {
      "const": false
    },
    "provider_execution_performed": {
      "const": false
    },
    "request_id": {
      "pattern": "^wfr-",
      "type": "string"
    },
    "request_type": {
      "enum": [
        "coaching_request",
        "context_strain_review",
        "continuity_review",
        "institutional_improvement_review",
        "lessons_learned_intake",
        "onboarding_request",
        "overload_review",
        "reassignment_review",
        "reflection_cycle_request",
        "repeated_error_review",
        "role_fit_review",
        "staffing_request",
        "stand_down_review",
        "worker_health_review"
      ]
    },
    "requested_outcome": {
      "minLength": 1,
      "type": "string"
    },
    "requesting_office": {
      "minLength": 1,
      "type": "string"
    },
    "requires_boundary_review": {
      "description": "Must be true for private, sensitive, continuity, resident identity, connector, or protected-source subjects.",
      "type": "boolean"
    },
    "requires_steward_attention": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "workforce_request.v1"
    },
    "source_artifacts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "open",
        "blocked",
        "in_review",
        "ready_for_action",
        "closed",
        "declined"
      ]
    },
    "subject_id": {
      "minLength": 1,
      "type": "string"
    },
    "subject_type": {
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "description": "Classification-appropriate summary only; unrestricted private journal bodies are prohibited.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "request_type",
    "subject_id",
    "subject_type",
    "requesting_office",
    "summary",
    "requested_outcome",
    "classification",
    "source_artifacts",
    "requires_steward_attention",
    "requires_boundary_review",
    "created_at",
    "status",
    "metadata"
  ],
  "title": "Helen Workforce Request v1",
  "type": "object"
}
