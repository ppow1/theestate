{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.diagnostic-impact-packet.v1",
  "title": "Estate Diagnostic Impact Packet",
  "type": "object",
  "required": ["schema_version", "packet_id", "component", "intended_behavior", "changed_artifacts", "dependencies", "invariants", "failure_seams", "probes", "evidence", "boundaries", "affected_checkpoints", "proposed_knowledge", "confidence", "source", "implementation_revision"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "intended_behavior": {"type": "string", "minLength": 1},
    "changed_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "git_blob", "head_git_blob", "worktree_state"]}},
    "dependencies": {"$ref": "#/$defs/nonEmptyStrings"}, "invariants": {"$ref": "#/$defs/nonEmptyStrings"},
    "failure_seams": {"$ref": "#/$defs/nonEmptyStrings"}, "probes": {"$ref": "#/$defs/nonEmptyStrings"},
    "evidence": {"$ref": "#/$defs/nonEmptyStrings"}, "boundaries": {"$ref": "#/$defs/nonEmptyStrings"},
    "affected_checkpoints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "proposed_knowledge": {"type": "array", "items": {"type": "object", "required": ["state", "text"], "properties": {"state": {"enum": ["CANDIDATE", "PROPOSED"]}, "text": {"type": "string", "minLength": 1}}}},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "source": {"type": "object", "required": ["kind", "actor", "created_at"], "properties": {"kind": {"enum": ["human", "ai", "automation"]}}},
    "implementation_revision": {"type": "object", "required": ["git_revision", "worktree_dirty"]}
  },
  "$defs": {"nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
