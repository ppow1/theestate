{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"estate.resident_identity_package.v1",
  "type":"object",
  "required":["contract","canonical_identity","character_bible","physical_identity","voice_identity","visual_presentation","office_environment","relationships","preferences_and_growth","runtime_presentation_contract","validation_and_commissioning","privacy","provenance","implementation_bindings"],
  "additionalProperties":false,
  "properties":{
    "contract":{"type":"object","required":["name","version"],"properties":{"name":{"const":"estate.resident_identity_package"},"version":{"const":"1.0.0"}},"additionalProperties":false},
    "canonical_identity":{"type":"object","required":["resident_id","resident_name","role","office","authority_summary","classification","lifecycle_state","identity_anchors","prohibited_identity_drift"],"properties":{"resident_id":{"type":"string","pattern":"^resident\\.[a-z0-9_]+$"},"resident_name":{"type":"string"},"employee_id":{"type":["string","null"]},"role":{"type":"string"},"office":{"type":"string"},"authority_summary":{"type":"object","required":["claim","source"],"properties":{"claim":{"enum":["none","advisory","operational_support","office_delegate","steward_delegated"]},"source":{"type":"string"}},"additionalProperties":false},"classification":{"enum":["public","internal","restricted"]},"lifecycle_state":{"enum":["draft","candidate","active","commissioned","retired"]},"identity_anchors":{"type":"array","minItems":3,"items":{"type":"string"}},"prohibited_identity_drift":{"type":"array","minItems":1,"items":{"type":"string"}}},"additionalProperties":false},
    "character_bible":{"type":"object","required":["temperament","values","communication_style","humor","emotional_range","strengths","limitations","boundaries","behavioral_failure_modes","prohibited_generic_behaviors"],"additionalProperties":true},
    "physical_identity":{"type":"object","required":["appearance_summary","age_presentation","height_and_proportions","face","hair","eyes","complexion","distinguishing_features","posture","movement","natural_imperfections","wardrobe_preferences","jewelry","accessories","fragrance","grooming","footwear","image_continuity_constraints","non_explicit"],"properties":{"non_explicit":{"const":true}},"additionalProperties":true},
    "voice_identity":{"type":"object","required":["vocal_presence","accent_guidance","cadence","energy","pitch_range","emotional_modulation","humor_delivery","pauses","emphasis","pronunciation_notes","engine_neutral_description"],"additionalProperties":true},
    "visual_presentation":{"type":"object","required":["canonical_portrait_specification","expression_sheet","wardrobe_sheet","office_background_requirements","avatar_crops","provenance","versioning","renderer_bindings_reference"],"additionalProperties":true},
    "office_environment":{"type":"object","required":["description","lighting","furnishings","desk_objects","personal_items","books","tools","plants","artwork","memorabilia","public_private_areas","environmental_cues"],"additionalProperties":true},
    "relationships":{"type":"object","required":["relationship_profile_reference","steward","active_residents"],"additionalProperties":true},
    "preferences_and_growth":{"type":"object","required":["wp_4053_linkage","preferences"],"properties":{"wp_4053_linkage":{"type":"string","pattern":"WP-4053"},"preferences":{"type":"array","items":{"type":"object","required":["name","category","provenance"],"properties":{"name":{"type":"string"},"category":{"enum":["identity_anchor","durable","seeded","contextual","evolving","experimental","changed","retired","disputed"]},"provenance":{"type":"string"},"wp_4053_evidence":{"type":"string"}},"additionalProperties":false}}},"additionalProperties":false},
    "runtime_presentation_contract":{"type":"object","required":["prompt_identity_reference","fallback_behavior","capabilities","tool_access","model_entitlement","continuity_policy","session_privacy","open_webui_metadata","avatar_binding","voice_binding","activation_claim"],"properties":{"activation_claim":{"enum":["not_activated","staged_only","runtime_ready_by_separate_install"]}},"additionalProperties":true},
    "validation_and_commissioning":{"type":"object","required":["readiness_state","checks","commissioning_notes"],"properties":{"readiness_state":{"enum":["draft","character_review_ready","identity_complete","presentation_ready","runtime_ready","commissioned","revision_required","retired"]}},"additionalProperties":true},
    "privacy":{"type":"object","required":["audience_scoped_fields","restricted_handling"],"additionalProperties":true},
    "provenance":{"type":"object","required":["created_by","created_at","sources","change_control"],"additionalProperties":true},
    "implementation_bindings":{"type":"object","required":["provider","model","voice_engine","portrait_renderer","interface"],"additionalProperties":true}
  }
}
