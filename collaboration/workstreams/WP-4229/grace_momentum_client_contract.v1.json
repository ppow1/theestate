  "query_schema": {"queries": ["objective.summary", "lifecycle.timeline", "responsibility.current", "blocker.current", "action.next_lawful", "directive.state", "capability.state", "commission.state", "provider_governance.state", "dispatch.state", "validation.state", "replay.state", "audit.trail"]},
  "event_schema": {"required": ["schema_version", "event_id", "event_type", "position", "occurred_at", "correlation_id", "causation_id", "actor", "represented_office", "authority_source", "idempotency_key", "audit_reference", "payload"], "event_types": ["objective.created_or_correlated", "directive.authorized", "directive.paused", "directive.resumed", "directive.stopped", "directive.revoked", "directive.superseded", "directive.transitioned", "capability.determined", "commission.accepted", "cme.evaluation.persisted", "progression.changed", "progression.inspected", "execution.authorized", "dispatch.submitted", "dispatch.requested", "dispatch.started", "dispatch.completed", "provider.admitted", "provider.execution.completed", "reconciliation.completed", "validation.succeeded", "validation.failed", "grace.receipt.recorded", "objective.completed", "directive.completed", "blocker.raised", "escalation.requested", "recovery.performed", "rollback.recorded"]},
  "fake_service_entry_point": "estate.core.grace_momentum_service.FakeGraceMomentumService",
