  "event_consumption": {"canonical_api": "client.replay(cursor, limit=100)", "subscription_alias": "client.subscribe(cursor, limit=100)", "cursor": "exclusive durable event position", "bounded_polling": true, "maximum_limit": 1000, "response_fields": ["cursor", "next_cursor", "has_more", "events"]},
