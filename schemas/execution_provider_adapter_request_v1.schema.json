{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.execution-provider-adapter.request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_request_id", "dispatch_id", "provider_id", "provider_type", "adapter_reference", "prompt_source", "prompt_source_type", "prompt_source_digest", "read_scope_paths", "write_scope_paths", "expected_outputs", "decision_reference", "authorization_reference", "grace_objective_id", "grace_action_id", "helen_determination_id", "engineering_commission_id", "engineering_authorization_id", "ptm_readiness", "provider_extension"],
  "properties": {
    "adapter_request_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_type": {"type": "string", "minLength": 1},
    "adapter_reference": {"type": "string", "minLength": 1},
    "profile_label": {"type": ["string", "null"]},
    "work_package_id": {"type": ["string", "null"]},
    "work_package_path": {"type": ["string", "null"]},
    "prompt_source": {"type": "string", "minLength": 1},
    "prompt_source_type": {"const": "estate.grace.action.v1"},
    "prompt_source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "read_scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "write_scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blocked_scope_paths": {"type": "array", "items": {"type": "string"}},
    "classification": {"type": "string", "minLength": 1},
    "validation_required": {"type": "boolean"},
    "boundary_review_reference": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "decision_reference": {"type": "string", "minLength": 1},
    "authorization_reference": {"type": "string", "minLength": 1},
    "grace_objective_id": {"type": "string", "minLength": 1},
    "grace_action_id": {"type": "string", "minLength": 1},
    "helen_determination_id": {"type": "string", "minLength": 1},
    "engineering_commission_id": {"type": "string", "minLength": 1},
    "engineering_authorization_id": {"type": "string", "minLength": 1},
    "ptm_readiness": {"type": "object", "minProperties": 1},
    "compute_resource_requirements": {"$ref": "estate.compute-resource-requirements.v1"},
    "metadata": {"type": "object"},
    "provider_extension": {"anyOf": [{"$ref": "estate.qwen-local-text.execution-extension.v1"}, {"type": "object", "maxProperties": 0}]}
  }
}
