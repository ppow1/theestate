{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.execution-provider-adapter.request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_request_id", "dispatch_id", "provider_id", "provider_type", "prompt_source", "read_scope_paths", "write_scope_paths", "expected_outputs", "decision_reference"],
  "properties": {
    "adapter_request_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_type": {"type": "string", "minLength": 1},
    "prompt_source": {"type": "string", "minLength": 1},
    "read_scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "write_scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decision_reference": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}
