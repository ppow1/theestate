{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering.authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engineering_authorization_id", "authorization_id", "engineering_commission_id", "dispatch_id", "provider_id", "provider_type", "adapter_reference", "grace_objective_id", "grace_action_id", "helen_determination_id", "operations_decision_id", "decision_reference", "authorization_reference", "ptm_readiness", "prompt_source", "prompt_source_type", "prompt_source_digest", "allowed_read_paths", "allowed_write_paths", "expected_outputs", "execution_authority", "provider_extension", "authorization_state", "authorized_at", "expires_at", "institutional_acceptance_state", "idempotency_key", "record_digest"],
  "properties": {
    "schema_version": {"const": "estate.engineering.authorization.v1"},
    "engineering_authorization_id": {"type": "string", "pattern": "^engauth-[A-Za-z0-9_-]+$"},
    "authorization_id": {"type": "string", "pattern": "^engauth-[A-Za-z0-9_-]+$"},
    "engineering_commission_id": {"type": "string", "pattern": "^engcom-[A-Za-z0-9_-]+$"},
    "dispatch_id": {"type": "string", "pattern": "^dispatch-[A-Za-z0-9_-]+$"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_type": {"type": "string", "minLength": 1},
    "adapter_reference": {"type": "string", "minLength": 1},
    "grace_objective_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"},
    "grace_action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"},
    "helen_determination_id": {"type": "string", "minLength": 1},
    "operations_decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"},
    "decision_reference": {"type": "string", "pattern": "^operations-control/[A-Za-z0-9_.-]+$"},
    "authorization_reference": {"type": "string", "pattern": "^runtime/grace_helen_engineering/engineering_authorizations/[A-Za-z0-9_-]+[.]json$"},
    "ptm_readiness": {"$ref": "estate.engineering.commission-ptm-evidence.v1"},
    "prompt_source": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"},
    "prompt_source_type": {"const": "estate.grace.action.v1"},
    "prompt_source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_read_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"}},
    "allowed_write_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"}},
    "expected_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"}},
    "execution_authority": {"$ref": "estate.engineering.commission-execution-authority.v1"},
    "authorization_state": {"const": "authorized_for_dispatch"},
    "authorized_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "institutional_acceptance_state": {"const": "not_granted"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "record_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "engineering_work_item_id": {"type": "string", "minLength": 1},
    "selected_capability_profile": {"type": "string", "minLength": 1},
    "provider_selection_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "dispatch_record_path": {"type": "string", "pattern": "^runtime/execution_dispatch/[A-Za-z0-9_./-]+$"},
    "ptm_revalidated_at": {"type": "string", "format": "date-time"},
    "ptm_revalidation_result": {"const": "passed"}
    ,"provider_extension": {"$ref": "estate.qwen-local-text.execution-extension.v1"}
  }
}
