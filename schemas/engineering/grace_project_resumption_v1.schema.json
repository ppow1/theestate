{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering.grace-project-resumption.v1",
  "title": "Grace Original Project Resumption",
  "type": "object",
  "additionalProperties": false,
  "required": ["resumption_id", "original_objective_id", "dependency_id", "reevaluation_id", "state", "created_at"],
  "properties": {
    "resumption_id": {"type": "string", "minLength": 1},
    "original_objective_id": {"type": "string", "minLength": 1},
    "dependency_id": {"type": "string", "minLength": 1},
    "reevaluation_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["resumable", "resumed", "remains_blocked", "failed"]},
    "new_attempt_id": {"type": ["string", "null"]},
    "new_dispatch_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "repeated_steward_intake_required": {"const": false},
    "evidence_references": {"type": "array", "items": {"type": "string"}}
  }
}
