{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering.worker-specification.v1",
  "title": "Engineering Worker Capability Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["specification_id", "gap_id", "capability_id", "produced_by", "boundaries", "qualification_requirements", "validation_requirements", "created_at"],
  "properties": {
    "specification_id": {"type": "string", "minLength": 1},
    "gap_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "produced_by": {"const": "Engineering"},
    "consultation_id": {"type": "string", "minLength": 1},
    "boundaries": {"type": "object"},
    "qualification_requirements": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "health_checks": {"type": "array", "items": {"type": "object"}},
    "execution_expectations": {"type": "object"},
    "adapter_expectations": {"type": "object"},
    "artifact_contract": {"type": "object"},
    "receipt_contract": {"type": "object"},
    "bootstrap_dependencies": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "implementation_authorized": {"const": false}
  }
}
