{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering.commission-execution-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt_source", "prompt_source_type", "prompt_source_digest", "allowed_read_paths", "allowed_write_paths", "expected_outputs", "grace_objective_id", "grace_action_id"],
  "properties": {
    "prompt_source": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$)).+"},
    "prompt_source_type": {"type": "string", "minLength": 1},
    "prompt_source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_read_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowed_write_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "grace_objective_id": {"type": "string", "minLength": 1},
    "grace_action_id": {"type": "string", "minLength": 1},
    "prompt_source_record": {"type": "string", "minLength": 1}
  }
}
