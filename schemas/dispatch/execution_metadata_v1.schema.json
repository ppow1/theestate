{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.dispatch.execution-metadata.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["technical_execution", "capability_disposition", "validation_required", "institutional_acceptance_state", "grace_objective_id", "grace_action_id", "capability_inquiry_reference", "helen_determination_id", "operations_decision_id", "engineering_commission_id", "engineering_authorization_id", "provider_id", "provider_type", "adapter_reference", "ptm_readiness", "ptm_revalidated_at", "ptm_revalidation_result", "authorization_reference", "decision_reference", "authorization_record_digest", "execution_authority"],
  "properties": {
    "technical_execution": {"const": true},
    "capability_disposition": {"const": "qualified_and_available"},
    "validation_required": {"const": true},
    "institutional_acceptance_state": {"const": "not_granted"},
    "grace_objective_id": {"type": "string", "minLength": 1},
    "grace_action_id": {"type": "string", "minLength": 1},
    "capability_inquiry_reference": {"type": "string", "minLength": 1},
    "helen_determination_id": {"type": "string", "minLength": 1},
    "operations_decision_id": {"type": "string", "minLength": 1},
    "engineering_commission_id": {"type": "string", "minLength": 1},
    "engineering_authorization_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_type": {"type": "string", "minLength": 1},
    "adapter_reference": {"type": "string", "minLength": 1},
    "prompt_source_type": {"const": "estate.grace.action.v1"},
    "prompt_source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_record_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_reference": {"type": "string", "pattern": "^runtime/grace_helen_engineering/engineering_authorizations/[A-Za-z0-9_-]+[.]json$"},
    "decision_reference": {"type": "string", "pattern": "^operations-control/[A-Za-z0-9_-]+$"},
    "ptm_readiness": {"$ref": "estate.engineering.commission-ptm-evidence.v1"},
    "ptm_revalidated_at": {"type": "string", "format": "date-time"},
    "ptm_revalidation_result": {"const": "passed"},
    "execution_authority": {"$ref": "estate.engineering.commission-execution-authority.v1"},
    "provider_extension": {"anyOf": [{"$ref": "estate.qwen-local-text.execution-extension.v1"}, {"type": "object", "additionalProperties": false}, {"type": "null"}]}
    ,"adapter_result_reference": {"type": "string", "minLength": 1}
    ,"adapter_result_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    ,"provider_execution_state": {"enum": ["accepted", "dry_run_completed", "blocked", "failed", "completed"]}
    ,"validation_state": {"enum": ["prepared", "passed", "failed", "not_run"]}
    ,"result_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"provider_id": {"const": "qwen.local.text"}}, "required": ["provider_id"]}, "then": {"required": ["provider_extension"], "properties": {"provider_extension": {"$ref": "estate.qwen-local-text.execution-extension.v1"}}}}
  ]
}
