{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.dispatch.readiness-evidence.v1",
  "type": "object",
  "required": ["engineering_commission_id", "readiness_resolution_id", "readiness_projection_path", "readiness_projection_digest", "source_high_watermark", "readiness_state", "evaluated_at", "expires_at", "freshness_policy_id", "freshness_policy_version", "freshness_policy_digest", "waiver_registry_id", "waiver_registry_version", "waiver_registry_digest", "revalidated_at", "revalidation_result"],
  "properties": {
    "engineering_commission_id": {"type": "string", "minLength": 1},
    "readiness_resolution_id": {"type": "string", "minLength": 1},
    "readiness_projection_path": {"type": "string", "pattern": "^runtime/ptm/readiness/[A-Za-z0-9_.-]+[.]json$"},
    "readiness_projection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_high_watermark": {"type": "string", "minLength": 1},
    "readiness_state": {"enum": ["ready", "waived"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "freshness_policy_id": {"type": ["string", "null"]},
    "freshness_policy_version": {"type": ["string", "null"]},
    "freshness_policy_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "waiver_registry_id": {"type": ["string", "null"]},
    "waiver_registry_version": {"type": ["string", "null"]},
    "waiver_registry_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "revalidated_at": {"type": "string", "format": "date-time"},
    "revalidation_result": {"const": "passed"}
  },
  "additionalProperties": false
}
