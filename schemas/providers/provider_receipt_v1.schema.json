{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.provider-receipt.v1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "estate.provider-receipt.v1"},
    "governed_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_type", "adapter_reference", "adapter_id", "adapter_version", "request_id", "dispatch_id", "grace_objective_id", "grace_action_id", "capability_inquiry_reference", "helen_assessment_reference", "ptm_readiness_resolution_id", "ptm_readiness_projection_digest", "engineering_commission_id", "engineering_authorization_id", "authorization_reference", "authorization_record_digest", "operations_decision_reference", "operations_decision_id", "prompt_source", "prompt_source_type", "prompt_source_digest", "allowed_read_paths", "allowed_write_paths", "expected_outputs", "artifact_path", "provider_receipt_path"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider_type": {"type": "string", "minLength": 1},
        "adapter_reference": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "grace_objective_id": {"type": "string", "minLength": 1},
        "grace_action_id": {"type": "string", "minLength": 1},
        "capability_inquiry_reference": {"type": "string", "minLength": 1},
        "helen_assessment_reference": {"type": "string", "minLength": 1},
        "ptm_readiness_resolution_id": {"type": "string", "minLength": 1},
        "ptm_readiness_projection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "engineering_commission_id": {"type": "string", "minLength": 1},
        "engineering_authorization_id": {"type": "string", "minLength": 1},
        "authorization_reference": {"type": "string", "minLength": 1},
        "authorization_record_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "operations_decision_reference": {"type": "string", "minLength": 1},
        "operations_decision_id": {"type": "string", "minLength": 1},
        "prompt_source": {"type": "string", "minLength": 1},
        "prompt_source_type": {"type": "string", "minLength": 1},
        "prompt_source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "allowed_read_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_write_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_path": {"type": "string", "minLength": 1},
        "provider_receipt_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
