{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.residents.capability-manifest.v1",
  "title": "Estate Resident Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resident_id", "owner", "capabilities"],
  "properties": {
    "schema_version": {"const": "resident_capability_manifest_v1"},
    "resident_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "owner": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}
  },
  "$defs": {
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "version", "maturity_level", "current_availability", "dispatchability", "provider_bindings", "classification_ceiling", "accepted_inputs", "accepted_outputs", "limitations", "authorization_requirements", "evidence_sources"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "maturity_level": {"type": "integer", "minimum": 0, "maximum": 5},
        "current_availability": {"enum": ["available", "unavailable", "unknown", "expired", "degraded"]},
        "dispatchability": {"enum": ["dispatchable", "not_dispatchable", "not_applicable"]},
        "provider_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "classification_ceiling": {"type": "string", "minLength": 1},
        "accepted_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "accepted_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "authorization_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "implementation_worker_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "adapter_reference"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "adapter_reference": {"type": "string", "minLength": 1},
        "runtime_identity": {"type": "string", "minLength": 1}
      }
    }
  }
}
