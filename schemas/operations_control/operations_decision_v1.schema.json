{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.operations-control.decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "created_at", "decided_by", "decision_type", "decision_state", "target_type", "classification", "reason", "priority", "requires_boundary_review", "requires_steward_attention", "summary_safe", "metadata", "institutional_acceptance_state"],
  "properties": {
    "schema_version": {"const": "estate.operations-control.decision.v1"},
    "decision_id": {"type": "string", "pattern": "^opdec-[A-Za-z0-9_-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "decided_by": {"type": "string", "minLength": 1},
    "decision_type": {"enum": ["assign", "reprioritize", "hold", "release", "defer", "cancel", "escalate", "request_boundary_review", "request_revision", "request_validation", "authorize_dispatch"]},
    "decision_state": {"enum": ["recorded", "authorized_for_dispatch", "expired", "rejected", "cancelled"]},
    "target_type": {"enum": ["intake", "schedule", "dispatch", "assignment", "provider", "work_package", "system"]},
    "target_id": {"type": ["string", "null"]},
    "classification": {"type": "string", "minLength": 1},
    "priority": {"enum": ["low", "normal", "high", "urgent"]},
    "reason": {"type": "string", "minLength": 1},
    "next_state": {"type": ["string", "null"]},
    "assignment_label": {"type": ["string", "null"]},
    "provider_id": {"type": ["string", "null"]},
    "worker_id": {"type": ["string", "null"]},
    "seat_id": {"type": ["string", "null"]},
    "requires_boundary_review": {"type": "boolean"},
    "requires_steward_attention": {"type": "boolean"},
    "summary_safe": {"type": "boolean"},
    "metadata": {"type": "object", "additionalProperties": true},
    "institutional_acceptance_state": {"const": "not_granted"},
    "technical_execution": {"type": "boolean"},
    "grace_objective_id": {"type": ["string", "null"]},
    "grace_action_id": {"type": ["string", "null"]},
    "helen_determination_id": {"type": ["string", "null"]},
    "ptm_readiness": {"anyOf": [{"$ref": "estate.engineering.commission-ptm-evidence.v1"}, {"type": "null"}]},
    "engineering_commission_id": {"type": ["string", "null"]},
    "engineering_authorization_id": {"type": ["string", "null"]},
    "dispatch_id": {"type": ["string", "null"]},
    "selected_provider_id": {"type": ["string", "null"]},
    "selected_adapter_reference": {"type": ["string", "null"]},
    "authorization_reference": {"type": ["string", "null"]},
    "decision_reference": {"type": ["string", "null"]},
    "prompt_source": {"type": ["string", "null"]},
    "prompt_source_digest": {"type": ["string", "null"]},
    "allowed_read_paths": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string"}},
    "allowed_write_paths": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string"}},
    "expected_outputs": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string"}},
    "authorized_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "idempotency_key": {"type": ["string", "null"]},
    "record_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "parent_operations_decision_id": {"type": ["string", "null"]},
    "provider_extension": {"anyOf": [{"$ref": "estate.qwen-local-text.execution-extension.v1"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"technical_execution": {"const": true}}, "required": ["technical_execution"]}, "then": {"required": ["grace_objective_id", "grace_action_id", "helen_determination_id", "ptm_readiness", "engineering_commission_id", "engineering_authorization_id", "dispatch_id", "selected_provider_id", "selected_adapter_reference", "authorization_reference", "decision_reference", "prompt_source", "prompt_source_digest", "allowed_read_paths", "allowed_write_paths", "expected_outputs", "authorized_at", "expires_at", "idempotency_key", "record_digest", "parent_operations_decision_id", "provider_extension"], "properties": {"decision_type": {"const": "authorize_dispatch"}, "decision_state": {"const": "authorized_for_dispatch"}, "technical_execution": {"const": true}, "metadata": {"type": "object", "additionalProperties": false, "required": ["parent_operations_decision_id"], "properties": {"parent_operations_decision_id": {"type": "string", "minLength": 1}}}}}}
  ]
}
