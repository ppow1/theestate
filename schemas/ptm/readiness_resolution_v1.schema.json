{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.ptm.readiness-resolution.v1",
  "type": "object",
  "required": ["resolution_id", "schema_version", "objective_id", "task_id", "dependency_results", "gate_checks", "readiness_state", "source_references", "source_digests", "source_high_watermark", "evaluator_identity", "freshness_policy_id", "freshness_policy_digest", "evaluated_at", "expires_at", "waiver_references", "conflicts", "warnings", "replay_idempotency_key", "failure_reason", "ledger_event_reference", "projection_path", "projection_digest"],
  "properties": {
    "resolution_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "estate.ptm.readiness-resolution.v1"},
    "objective_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": ["string", "null"]},
    "package_id": {"type": ["string", "null"]},
    "task_id": {"type": "string", "minLength": 1},
    "enabling_project_id": {"type": ["string", "null"]},
    "dependency_results": {"type": "array", "items": {"type": "object", "required": ["dependency_id", "state"], "properties": {"dependency_id": {"type": "string", "minLength": 1}, "state": {"enum": ["unsatisfied", "satisfied", "waived", "unknown"]}, "objective_id": {"type": "string"}, "package_id": {"type": "string"}, "task_id": {"type": "string"}, "depends_on": {"type": "array", "items": {"type": "string"}}, "observed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "waiver": {"type": ["object", "null"]}}, "additionalProperties": false}},
    "gate_checks": {"type": "array", "items": {"type": "object", "required": ["name", "state"], "properties": {"name": {"type": "string", "minLength": 1}, "state": {"enum": ["pass", "fail", "waived", "unknown"]}, "observed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false}},
    "readiness_state": {"enum": ["not_ready", "ready", "blocked", "waived", "unknown"]},
    "source_references": {"type": "array", "items": {"type": "object", "required": ["source_path", "source_sha256", "adapter_name", "adapter_version"], "properties": {"source_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[.][.](?:/|$)).+"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "adapter_name": {"type": "string"}, "adapter_version": {"type": "string"}}, "additionalProperties": false}},
    "source_digests": {"type": "object"},
    "source_high_watermark": {"type": "string"},
    "evaluator_identity": {"type": "string"},
    "freshness_policy_id": {"type": ["string", "null"]},
    "freshness_policy_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "waiver_references": {"type": "array"},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "replay_idempotency_key": {"type": "string"},
    "failure_reason": {"type": ["string", "null"]},
    "ledger_event_reference": {"type": ["string", "null"]},
    "projection_path": {"type": ["string", "null"], "pattern": "^runtime/ptm/readiness/[A-Za-z0-9_.-]+[.]json$"},
    "projection_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
