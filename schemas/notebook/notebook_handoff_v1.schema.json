{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering-notebook.handoff.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "notebook_id", "created_at", "previous_worker", "next_worker", "session_id", "revision", "state_digest", "reason", "packet_digest", "resume_required", "institutional_acceptance"],
  "properties": {"schema_version": {"const": "estate.engineering-notebook.handoff.v1"}, "handoff_id": {"type": "string", "minLength": 1}, "notebook_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "previous_worker": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "next_worker": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "session_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "revision": {"type": "integer", "minimum": 0}, "state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reason": {"type": "string", "minLength": 1}, "packet_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "resume_required": {"const": true}, "institutional_acceptance": {"const": "not_granted"}}
}
