{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering-notebook.state.v1",
  "title": "Estate Engineering Notebook State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notebook_id", "notebook_type", "owner", "assigned_worker", "objective_id", "work_package_ref", "created_at", "last_verified_at", "source_commit", "status", "revision", "last_update_id", "last_receipt_id", "last_idempotency_key", "prior_state_digest", "state_digest", "applied_update_ids", "applied_idempotency_keys", "task", "authority", "constraints", "architecture", "evidence", "continuity", "freshness", "provenance", "institutional_acceptance"],
  "properties": {
    "schema_version": {"const": "estate.engineering-notebook.state.v1"},
    "notebook_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "notebook_type": {"const": "engineering_working_state"},
    "owner": {"type": "string", "minLength": 1},
    "assigned_worker": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "objective_id": {"type": "string", "minLength": 1}, "work_package_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}, "last_verified_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "minLength": 1},
    "status": {"enum": ["current", "stale", "conflicted", "incomplete", "blocked", "completed", "archived"]},
    "revision": {"type": "integer", "minimum": 0},
    "last_update_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "last_receipt_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "last_idempotency_key": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "prior_state_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applied_update_ids": {"$ref": "#/$defs/idList"}, "applied_idempotency_keys": {"$ref": "#/$defs/idList"},
    "task": {"$ref": "#/$defs/task"}, "authority": {"$ref": "#/$defs/authority"}, "constraints": {"$ref": "#/$defs/constraints"}, "architecture": {"$ref": "#/$defs/lists"}, "evidence": {"$ref": "#/$defs/evidence"}, "continuity": {"$ref": "#/$defs/continuity"}, "freshness": {"$ref": "#/$defs/freshness"},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}, "institutional_acceptance": {"const": "not_granted"}
  },
  "$defs": {
    "idList": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "uniqueItems": true},
    "textList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "safeList": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)[.][.](?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"}},
    "lists": {"type": "object", "additionalProperties": false, "required": ["protected_components", "runtime_boundaries", "do_not_redesign", "required_interfaces", "governing_documents", "accepted_decisions", "unresolved_decisions"], "properties": {"protected_components": {"$ref": "#/$defs/safeList"}, "runtime_boundaries": {"$ref": "#/$defs/safeList"}, "do_not_redesign": {"$ref": "#/$defs/safeList"}, "required_interfaces": {"$ref": "#/$defs/safeList"}, "governing_documents": {"$ref": "#/$defs/safeList"}, "accepted_decisions": {"$ref": "#/$defs/safeList"}, "unresolved_decisions": {"$ref": "#/$defs/safeList"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["original_objective", "current_stage", "stage_status", "completed_stages", "remaining_stages", "next_action", "current_blocker", "blocking_severity", "repair_count", "retry_limit", "stop_condition"], "properties": {"original_objective": {"type": "string", "minLength": 1}, "current_stage": {"type": "string", "minLength": 1}, "stage_status": {"enum": ["pending", "active", "complete", "blocked"]}, "completed_stages": {"$ref": "#/$defs/textList"}, "remaining_stages": {"$ref": "#/$defs/textList"}, "next_action": {"type": "string", "minLength": 1}, "current_blocker": {"type": "string", "minLength": 1}, "blocking_severity": {"enum": ["none", "low", "medium", "high", "critical"]}, "repair_count": {"type": "integer", "minimum": 0}, "retry_limit": {"type": "integer", "minimum": 1}, "stop_condition": {"type": "string", "minLength": 1}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["references", "required", "merge", "network", "model_mutation", "destructive", "institutional_acceptance"], "properties": {"references": {"allOf": [{"$ref": "#/$defs/safeList"}, {"minItems": 1}]}, "required": {"$ref": "#/$defs/textList"}, "merge": {"type": "boolean"}, "network": {"type": "boolean"}, "model_mutation": {"type": "boolean"}, "destructive": {"type": "boolean"}, "institutional_acceptance": {"const": "not_granted"}}},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["permitted_repository", "permitted_read_paths", "permitted_write_paths", "permitted_commands", "prohibited_actions"], "properties": {"permitted_repository": {"$ref": "#/$defs/safeList"}, "permitted_read_paths": {"$ref": "#/$defs/safeList"}, "permitted_write_paths": {"$ref": "#/$defs/safeList"}, "permitted_commands": {"$ref": "#/$defs/textList"}, "prohibited_actions": {"$ref": "#/$defs/textList"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["stage", "output", "validation"], "properties": {"stage": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}, "validation": {"const": "pass"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["files", "commands", "last_results", "unresolved_failures", "test_counts", "schema_state", "compilation_state", "fixture_integrity", "sources", "receipts"], "properties": {"files": {"$ref": "#/$defs/safeList"}, "commands": {"$ref": "#/$defs/textList"}, "last_results": {"type": "array", "items": {"$ref": "#/$defs/result"}}, "unresolved_failures": {"$ref": "#/$defs/textList"}, "test_counts": {"type": "object", "additionalProperties": false, "required": ["passed", "failed"], "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}}, "schema_state": {"enum": ["unknown", "pass", "fail", "stale"]}, "compilation_state": {"enum": ["unknown", "pass", "fail", "stale"]}, "fixture_integrity": {"enum": ["unknown", "pass", "fail", "stale"]}, "sources": {"$ref": "#/$defs/safeList"}, "receipts": {"$ref": "#/$defs/safeList"}}},
    "continuity": {"type": "object", "additionalProperties": false, "required": ["previous_session", "handoff_reason", "compaction_summary", "safe_facts", "omitted_information", "next_stage_files", "expires_at"], "properties": {"previous_session": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "handoff_reason": {"type": "string", "minLength": 1}, "compaction_summary": {"type": "string", "minLength": 1}, "safe_facts": {"$ref": "#/$defs/textList"}, "omitted_information": {"$ref": "#/$defs/textList"}, "next_stage_files": {"$ref": "#/$defs/safeList"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["state", "checked_at", "source_digests", "max_age_seconds", "conflicts"], "properties": {"state": {"enum": ["current", "stale", "conflicted"]}, "checked_at": {"type": "string", "format": "date-time"}, "source_digests": {"type": "object", "propertyNames": {"pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)[.][.](?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"}, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "max_age_seconds": {"type": "integer", "minimum": 1}, "conflicts": {"$ref": "#/$defs/safeList"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "category", "digest", "observed_at", "claim"], "properties": {"source": {"type": "string", "minLength": 1}, "category": {"enum": ["worker_proposed", "harness_observed", "validator_produced", "operator_authorized", "repository_derived"]}, "digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "observed_at": {"type": "string", "format": "date-time"}, "claim": {"type": "string", "minLength": 1}}}
  }
}
