{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.engineering-notebook.verification-receipt.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "proposal_id", "notebook_id", "status", "accepted_at", "accepted_fields", "rejected_fields", "observed_facts", "state_digest", "institutional_acceptance", "revision", "idempotency_key", "prior_state_digest", "resulting_state_digest"],
  "properties": {
    "schema_version": {"const": "estate.engineering-notebook.verification-receipt.v1"}, "receipt_id": {"type": "string", "minLength": 1}, "proposal_id": {"type": "string", "minLength": 1}, "notebook_id": {"type": "string", "minLength": 1}, "status": {"enum": ["accepted", "replayed", "rejected", "conflicted"]}, "accepted_at": {"type": "string", "format": "date-time"}, "accepted_fields": {"type": "array", "items": {"type": "string"}}, "rejected_fields": {"type": "array", "items": {"type": "string"}}, "observed_facts": {"type": "object"}, "state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "institutional_acceptance": {"const": "not_granted"}, "revision": {"type": "integer", "minimum": 0}, "idempotency_key": {"type": "string", "minLength": 1}, "prior_state_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "resulting_state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
