    "room_id": {"type": "string"}, "session_id": {"type": "string"},
    "default_moderator_at_creation": {"type": "string"},
    "current_moderator": {"type": ["string", "null"]},
    "backup_moderator": {"type": ["string", "null"]},
    "active_participants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pending_acknowledgement": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "departed_participants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "removed_participants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "role_history": {"type": "array"}, "participant_history": {"type": "array"}, "audit_events": {"type": "array"}
  }
}
