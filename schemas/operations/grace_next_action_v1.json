{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theestate.local/schemas/operations/grace_next_action_v1.json",
  "title": "Grace Governed Next Action v1",
  "type": "object",
  "required": ["action_id", "objective_id", "created_at", "state", "proposal", "owner", "checkpoint", "traffic_controller_request", "classification", "priority"],
  "properties": {
    "action_id": {"type": "string", "pattern": "^grace-act-"},
    "objective_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"type": "string", "enum": ["proposed", "ready", "blocked", "awaiting_approval", "dispatch_requested", "escalated", "closed"]},
    "proposal": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "traffic_controller_request": {"type": "object"},
    "classification": {"type": "string"},
    "priority": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "dispatch_handoff_request": {"type": ["object", "null"]},
    "escalation": {"type": ["object", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
