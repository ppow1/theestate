{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.operational.event.v1",
  "title": "Estate normalized operational event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "source_system", "source_record", "subject", "observed_at", "effective_at", "prior_state", "new_state", "emitter", "authority_classification", "evidence_refs", "correlation_id", "causation_id", "severity", "idempotency_key", "schema_version"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "source_system": {"type": "string", "minLength": 1},
    "source_record": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "canonical_path"],
      "properties": {
        "subject_type": {"enum": ["campaign", "work_package", "resident", "service", "office", "worker", "provider", "validation_run", "evidence_package", "staffing_request", "message", "escalation", "protected_decision"]},
        "subject_id": {"type": "string", "minLength": 1},
        "canonical_path": {"type": "string", "minLength": 1}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"},
    "prior_state": {"$ref": "estate_operational_projection_v1.schema.json#/$defs/state"},
    "new_state": {"$ref": "estate_operational_projection_v1.schema.json#/$defs/state"},
    "emitter": {"type": "string", "minLength": 1},
    "authority_classification": {"enum": ["observation", "recommendation", "coordination", "execution_request", "delegated_mechanical", "office_decision", "protected_decision", "acceptance"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "severity": {"enum": ["info", "warning", "error", "critical"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "schema_version": {"const": "estate.operational.v1"},
    "metadata": {"type": "object"}
  }
}
