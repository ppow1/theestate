{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theestate.local/schemas/operations/grace_objective_v1.json",
  "title": "Grace Operational Objective v1",
  "type": "object",
  "required": ["objective_id", "created_at", "requested_by", "title", "summary", "classification", "priority", "authority"],
  "properties": {
    "objective_id": {"type": "string", "pattern": "^grace-obj-"},
    "created_at": {"type": "string", "format": "date-time"},
    "requested_by": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "classification": {"type": "string"},
    "priority": {"type": "string"},
    "work_package_id": {"type": ["string", "null"]},
    "authority": {"type": "string", "enum": ["delegated", "requires_steward", "unauthorized"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": ["string", "null"]},
    "checkpoint": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
