{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estate.operational.action.v1",
  "title": "Estate operational action descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_id", "action_class", "proposed_actor_id", "institutional_role", "identity_evidence", "source_refs", "target_ref", "target_mechanism", "authority_scope", "required_authority", "authority_evidence", "readiness_prerequisites", "validation_requirements", "evidence_requirements", "side_effect", "protected_surfaces", "idempotency_key", "retry_policy", "stop_conditions", "escalation_conditions", "disposition_state", "decision_or_execution_evidence", "schema_version"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "action_class": {"enum": ["observe", "recommend", "coordinate", "request_execution", "mechanical_action", "office_decision", "protected_decision", "acceptance"]},
    "proposed_actor_id": {"type": "string", "minLength": 1},
    "institutional_role": {"enum": ["steward", "chief_architect", "grace", "helen", "alfred", "engineering_worker", "execution_provider"]},
    "identity_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "target_ref": {"type": "string", "minLength": 1},
    "target_mechanism": {"enum": ["canonical_source_read", "office_decision_support", "office_runtime_or_repository_message", "execution_dispatch", "delegated_target_adapter", "canonical_office_record", "protected_authority_record", "existing_acceptance_lane"]},
    "authority_scope": {"type": "string", "minLength": 1},
    "required_authority": {"type": "string", "minLength": 1},
    "authority_evidence": {"type": "array", "items": {"type": "string"}},
    "readiness_prerequisites": {"type": "array", "items": {"type": "string"}},
    "validation_requirements": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "side_effect": {"enum": ["none", "advisory", "routing", "execution_request", "bounded_write", "decision_record", "protected_record", "acceptance_record"]},
    "protected_surfaces": {"type": "array", "items": {"type": "string"}},
    "idempotency_key": {"type": "string", "minLength": 1},
    "retry_policy": {"enum": ["never", "manual", "bounded_idempotent"]},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "escalation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disposition_state": {"enum": ["proposed", "evaluated", "denied", "requires_review", "disposed"]},
    "decision_or_execution_evidence": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"const": "estate.operational.action.v1"},
    "metadata": {"type": "object"}
  }
}
